rules_version = '2';

// 구글 로그인 + 초대코드 기반 공유 규칙
// - 각 사용자는 구글 계정으로 로그인한다.
// - users/{uid} 에는 내 프로필과 가입한 가족 그룹 목록이 저장되고 본인만 읽고 쓸 수 있다.
// - 가족 그룹의 초대코드(= 그룹 문서 ID)를 아는 사람만 members/{uid} 를 만들어 구성원이 될 수 있다.
// - 구성원만 그룹의 가족/기념일을 읽고 쓸 수 있다.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function groupPath(code) {
      return /databases/$(database)/documents/groups/$(code);
    }

    function isMember(code) {
      return signedIn() && exists(/databases/$(database)/documents/groups/$(code)/members/$(request.auth.uid));
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /groups/{code} {
      // 존재하지 않는 코드에만 생성 가능 (이미 있는 코드에 쓰면 update 로 취급되어 거부됨)
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string;
      allow read: if isMember(code);
      // 그룹 이름만 변경 가능
      allow update: if isMember(code)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']);

      match /members/{uid} {
        // 존재하는 그룹의 초대코드를 알면 본인을 구성원으로 등록할 수 있다
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && exists(groupPath(code));
        allow read: if isMember(code);
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      match /families/{familyId} {
        allow read, write: if isMember(code);
      }

      match /anniversaries/{anniversaryId} {
        allow read, write: if isMember(code);
      }
    }
  }
}
